<?xml version="1.0" encoding="utf-8"?>
<!-- Branded launch screen (Screens.md #1): the same indigo backdrop and Z/V
     mark as the launcher icon, so the hand-off from tapping the icon to the
     app opening reads as one continuous surface instead of a white flash.
     Automatically removed once the Flutter engine draws its first frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@drawable/ic_launcher_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher_foreground" />
    </item>
</layer-list>
