<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon (Android 8+). Launchers mask these two layers into
     whatever shape the device uses, so the mark in the foreground layer is
     scaled to the inner 72dp safe zone by tools/zivybb_logo.py. Older
     Androids fall back to the flattened mipmap-*/ic_launcher.png. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_foreground"/>
    <monochrome android:drawable="@mipmap/ic_launcher_foreground"/>
</adaptive-icon>
